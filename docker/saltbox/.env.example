# ==============================================================================
# SaltBox Side-by-Side Staging Environment Configuration
# Service: mylar-modern (Creator Identity Preview)
# Target Host: shroomserver (Partially Specialized / Fail-Closed Draft)
# ==============================================================================
# Copy this file to `/opt/mylar-modern/.env` on your SaltBox host.
#
# INSTRUCTIONS:
# 1. Populate all BLANK unresolved variables below before deploying.
# 2. DO NOT put passwords, tokens, or secrets in this file. GHCR authentication
#    is performed separately via `docker login` into the host credential store.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Docker Network Configuration (Directly Discovered on Host)
# ------------------------------------------------------------------------------
# Verified active external Docker bridge network
DOCKER_NETWORK=saltbox

# ------------------------------------------------------------------------------
# 2. Domain & Traefik Routing Configuration
# ------------------------------------------------------------------------------
# Primary SaltBox root domain (REQUIRED - e.g. yourdomain.tld)
DOMAIN=

# Approved project staging subdomain (produces: https://mylar-modern.yourdomain.tld)
SUBDOMAIN=mylar-modern

# Discovered Traefik entrypoint names
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure

# Traefik HTTP redirect middleware (REQUIRED - e.g. redirect-to-https@docker or chain-no-auth@file)
TRAEFIK_HTTP_MIDDLEWARES=

# Traefik HTTPS security & authentication middleware chain (REQUIRED - e.g. chain-authelia@file)
TRAEFIK_HTTPS_MIDDLEWARES=

# Traefik certificate resolver name (REQUIRED - Discovered options on host: cfdns, zerossl)
TRAEFIK_CERTRESOLVER=

# Optional Traefik TLS options label (leave blank if unused)
TRAEFIK_TLS_OPTIONS=

# ------------------------------------------------------------------------------
# 3. Host User, Group & Process Identity (Directly Discovered: shroom / 1000:1000)
# ------------------------------------------------------------------------------
PUID=1000
PGID=1000
TZ=America/Chicago

# ------------------------------------------------------------------------------
# 4. Staging Isolation Paths & Permissions (Deliberate D3 Isolation Choices)
# ------------------------------------------------------------------------------
APPDATA_DIR=/opt/mylar-modern
TEST_COMICS_DIR=/opt/mylar-modern/test_comics
DOWNLOADS_DIR=/opt/mylar-modern/downloads
UMASK=022

# ------------------------------------------------------------------------------
# 5. Optional Loopback Debug Port (Discovered Free Port)
# ------------------------------------------------------------------------------
# Used ONLY when running with the optional `docker-compose.loopback.yml` override.
HOST_PORT=8095
